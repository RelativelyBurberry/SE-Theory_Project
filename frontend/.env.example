# AlphaForge Insight — Frontend environment variables
# Copy this file to `.env.local` and adjust values as needed.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never commit real secrets (API keys, tokens) — they do not belong in .env files.

# Base URL of the R/Plumber backend API.
# Defaults to http://localhost:8000 when unset (see src/services/apiClient.js).
VITE_API_URL=http://localhost:8000